{
  "name": "@skyslope/forms-widget",
  "version": "1.5.0",
  "description": "Skyslope Forms Widget",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/skyslope/skyslope-forms-widget.git"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build:dev": "stencil build --docs --dev",
    "build:integ": "stencil build --docs --integ",
    "build:staging": "stencil build --docs --staging",
    "build:prod": "stencil build --docs --prod",
    "start": "stencil build --dev --watch --serve",
    "test": "node --require ./testing/puppeteer-compat.cjs ./node_modules/@stencil/core/bin/stencil test --spec --e2e",
    "test.watch": "npm test -- --watchAll",
    "generate": "stencil generate",
    "lint": "eslint src/**/*{.ts,.tsx}",
    "lint:fix": "eslint src/**/*{.ts,.tsx} --fix"
  },
  "dependencies": {
    "@stencil/core": "^3.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/core": "1.0.0-beta.13",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@stencil-community/eslint-plugin": "^0.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^5.57.0",
    "@typescript-eslint/parser": "^5.57.0",
    "eslint": "^8.37.0",
    "eslint-plugin-react": "^7.32.2",
    "husky": "^9.1.6",
    "jest": "^27.5.1",
    "jest-cli": "^27.5.1",
    "puppeteer": "25.18.1",
    "typescript": "^4.9.5"
  },
  "license": "MIT",
  "overrides": {
    "jsdom@16": {
      "http-proxy-agent": "^5.0.0"
    }
  }
}
